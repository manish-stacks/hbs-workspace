generator client { provider = "prisma-client-js" }
datasource db { provider = "mysql"
  url = env("DATABASE_URL") }

enum Status { ACTIVE SUSPENDED INACTIVE }

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company      Company?
  branches     Branch[]
  departments  Department[]
  designations Designation[]
  users        User[]
  roles        Role[]
  auditLogs    AuditLog[]
  subscription Subscription?
  employees    Employee[]
  attendances  Attendance[]
  attendanceLogs AttendanceLog[]
  corrections  AttendanceCorrection[]
  faceTemplates FaceTemplate[]
  shifts Shift[]
  shiftAssignments ShiftAssignment[]
  shiftSchedules ShiftSchedule[]
  swaps ShiftSwapRequest[]
  holidays Holiday[]
  leaveTypes LeaveType[]
  leavePolicies LeavePolicy[]
  leaveBalances LeaveBalance[]
  leaveApplications LeaveApplication[]
  payments     Payment[]
  salaryStructures SalaryStructure[]
  employeeLoans EmployeeLoan[]
  payrollRuns PayrollRun[]
  payrollItems PayrollItem[]
  payslips Payslip[]
  payrollAdjustments PayrollAdjustment[]
  companySettings CompanySetting[]
  notifications Notification[]
  celebrationTemplates CelebrationTemplate[]
  celebrationEvents CelebrationEvent[]
  crmLeads CrmLead[]
  crmCustomers CrmCustomer[]
  crmDeals CrmDeal[]
  crmActivitys CrmActivity[]
  crmTargets CrmTarget[]
  expenseClaims ExpenseClaim[]
  assets Asset[]
  assetAssignments AssetAssignment[]
  jobOpenings JobOpening[]
  candidates Candidate[]
  perfCycles PerfCycle[]
  goals Goal[]
  reviews Review[]
  tickets Ticket[]
  announcements Announcement[]
}
model Company {
  id        String  @id @default(cuid())
  tenantId  String  @unique
  name      String
  gstin     String?
  phone     String?
  address   String?
  timezone  String  @default("Asia/Kolkata")
  nextEmpNo Int     @default(1)
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
}
model Branch {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  isActive  Boolean @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, code])
  @@index([tenantId])
  employees Employee[]
  latitude Float?
  longitude Float?
  radiusMeters Int?
}
model Department {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, name])
  employees Employee[]
}
model Designation {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, name])
  employees Employee[]
}
model User {
  id           String  @id @default(cuid())
  tenantId     String?
  email        String  @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean @default(false)
  status       Status  @default(ACTIVE)
  branchId     String?
  departmentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant? @relation(fields: [tenantId], references: [id])
  roles        UserRole[]
  refreshTokens RefreshToken[]
  @@index([tenantId])
  employee Employee?
  notifications Notification[]
}
model Role {
  id        String  @id @default(cuid())
  tenantId  String?
  name      String
  isSystem  Boolean @default(false)
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  users     UserRole[]
  permissions RolePermission[]
  @@unique([tenantId, name])
}
model Permission {
  id    String @id @default(cuid())
  code  String @unique
  roles RolePermission[]
}
model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  tokenHash String   @unique
  tenantId  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([familyId])
}
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String?
  action    String
  entity    String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  @@index([tenantId, createdAt])
}

enum Cycle { MONTHLY YEARLY }
enum SubStatus { TRIAL ACTIVE PAST_DUE CANCELLED EXPIRED }
enum PayStatus { CREATED PAID FAILED }

model SubscriptionPlan {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  monthlyPrice Decimal @db.Decimal(10, 2)
  yearlyPrice  Decimal @db.Decimal(10, 2)
  maxEmployees Int
  maxBranches  Int
  trialDays    Int     @default(14)
  features     Json?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subscriptions Subscription[]
  payments      Payment[]
}
model Subscription {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  planId           String
  cycle            Cycle     @default(MONTHLY)
  status           SubStatus @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
  @@index([status, currentPeriodEnd])
}
model Payment {
  id                 String    @id @default(cuid())
  tenantId           String
  planId             String
  cycle              Cycle
  amount             Decimal   @db.Decimal(10, 2)
  status             PayStatus @default(CREATED)
  razorpayOrderId    String    @unique
  razorpayPaymentId  String?   @unique
  invoiceNo          String?   @unique
  createdAt          DateTime  @default(now())
  paidAt             DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
  @@index([tenantId, createdAt])
}
model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}

enum EmploymentType { FULL_TIME PART_TIME CONTRACT INTERN }
enum EmpStatus { ACTIVE ARCHIVED EXITED }
model Employee {
  id             String  @id @default(cuid())
  tenantId       String
  employeeCode   String
  fullName       String
  email          String?
  mobile         String?
  dob            DateTime? @db.Date
  gender         String?
  address        String? @db.Text
  emergencyContact String?
  joiningDate    DateTime @db.Date
  employmentType EmploymentType @default(FULL_TIME)
  status         EmpStatus @default(ACTIVE)
  designationId  String?
  departmentId   String?
  branchId       String?
  managerId      String?
  userId         String? @unique
  photoUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  department  Department?  @relation(fields: [departmentId], references: [id])
  branch      Branch?      @relation(fields: [branchId], references: [id])
  manager     Employee?    @relation("Reports", fields: [managerId], references: [id])
  reports     Employee[]   @relation("Reports")
  user        User?        @relation(fields: [userId], references: [id])
  bank        EmployeeBankDetails?
  transfers   EmployeeTransfer[]
  attendances Attendance[]
  corrections AttendanceCorrection[]
  faceTemplate FaceTemplate?
  shiftAssignments ShiftAssignment[]
  shiftSchedules ShiftSchedule[]
  swapsRequested ShiftSwapRequest[] @relation("SwapReq")
  swapsTargeted ShiftSwapRequest[] @relation("SwapTarget")
  leaveBalances LeaveBalance[]
  leaveApplications LeaveApplication[]
  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  salaryStructures SalaryStructure[]
  employeeLoans EmployeeLoan[]
  payrollItems PayrollItem[]
  payslips Payslip[]
  payrollAdjustments PayrollAdjustment[]
  celebrationEvents CelebrationEvent[]
  expenseClaims ExpenseClaim[]
  assetAssignments AssetAssignment[]
  goals Goal[]
  reviews Review[]
  tickets Ticket[]
}
model EmployeeBankDetails {
  id            String @id @default(cuid())
  employeeId    String @unique
  bankName      String?
  accountNumber String?
  ifsc          String?
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
model EmployeeTransfer {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  fromBranchId String?
  toBranchId   String?
  fromDepartmentId String?
  toDepartmentId   String?
  createdById  String
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([tenantId, employeeId])
}

enum AttStatus { PRESENT ABSENT HALF_DAY WEEKLY_OFF HOLIDAY ON_LEAVE }
enum AttMethod { FACE SELFIE GPS MANUAL }
enum CorrStatus { PENDING APPROVED REJECTED }
model Attendance {
  id          String    @id @default(cuid())
  tenantId    String
  employeeId  String
  workDate    DateTime  @db.Date
  status      AttStatus @default(PRESENT)
  checkInAt   DateTime?
  checkOutAt  DateTime?
  workMinutes Int?
  isLate      Boolean   @default(false)
  isEarlyOut  Boolean   @default(false)
  overtimeMinutes Int   @default(0)
  method      AttMethod
  branchId    String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, workDate])
  @@index([employeeId, checkInAt])
  shiftId     String?
  lateMinutes Int @default(0)
  shift       Shift? @relation(fields: [shiftId], references: [id])
}
model AttendanceLog {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String?
  attendanceId  String?
  type          String
  method        AttMethod
  success       Boolean
  failReason    String?
  lat           Float?
  lng           Float?
  distanceM     Float?
  matchDistance Float?
  deviceInfo    String?
  ip            String?
  selfie        Bytes?    @db.MediumBlob
  createdAt     DateTime  @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId, employeeId, createdAt])
}
model AttendanceCorrection {
  id              String     @id @default(cuid())
  tenantId        String
  employeeId      String
  workDate        DateTime   @db.Date
  requestedStatus AttStatus?
  requestedIn     DateTime?
  requestedOut    DateTime?
  reason          String
  status          CorrStatus @default(PENDING)
  reviewedById    String?
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  @@index([tenantId, status])
}
model FaceTemplate {
  id             String   @id @default(cuid())
  tenantId       String
  employeeId     String   @unique
  encTemplate    String   @db.Text
  consentAt      DateTime
  consentVersion String   @default("v1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

enum ShiftType { GENERAL MORNING EVENING NIGHT ROTATIONAL FLEXIBLE SPLIT CUSTOM }
enum HolidayType { COMPANY OPTIONAL }
enum SwapStatus { PENDING ACCEPTED APPROVED REJECTED }
model Shift {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  code          String
  type          ShiftType @default(GENERAL)
  startMinute   Int
  endMinute     Int
  breakMinutes  Int       @default(0)
  graceMinutes  Int       @default(0)
  earlyOutGraceMinutes Int @default(0)
  minWorkMinutes Int      @default(0)
  overtimeEnabled Boolean @default(false)
  overtimeAfterMinutes Int @default(0)
  weeklyOffDays String    @default("0")
  branchId      String?
  departmentId  String?
  effectiveFrom DateTime  @db.Date
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  assignments ShiftAssignment[]
  schedules   ShiftSchedule[]
  attendances Attendance[]
  @@unique([tenantId, code])
}
model ShiftAssignment {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  shiftId     String
  fromDate    DateTime @db.Date
  toDate      DateTime? @db.Date
  isTemporary Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id])
  @@index([tenantId, employeeId, fromDate])
}
model ShiftSchedule {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  date       DateTime @db.Date
  shiftId    String?
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id])
  @@unique([tenantId, employeeId, date])
}
model ShiftSwapRequest {
  id          String     @id @default(cuid())
  tenantId    String
  requesterId String
  targetId    String
  date        DateTime   @db.Date
  status      SwapStatus @default(PENDING)
  decidedById String?
  createdAt   DateTime   @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  requester Employee @relation("SwapReq", fields: [requesterId], references: [id], onDelete: Cascade)
  target    Employee @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
}
model Holiday {
  id           String      @id @default(cuid())
  tenantId     String
  name         String
  date         DateTime    @db.Date
  type         HolidayType @default(COMPANY)
  branchId     String?
  departmentId String?
  createdAt    DateTime    @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId, date])
}

enum LeaveStatus { PENDING APPROVED REJECTED CANCELLED }
model LeaveType {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String
  isPaid      Boolean @default(true)
  annualQuota Decimal @db.Decimal(6, 1) @default(0)
  carryForwardMax Decimal @db.Decimal(6, 1) @default(0)
  encashable  Boolean @default(false)
  allowHalfDay Boolean @default(true)
  approvalLevels Int  @default(1)
  genderRestriction String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  policies LeavePolicy[]
  balances LeaveBalance[]
  applications LeaveApplication[]
  @@unique([tenantId, code])
}
model LeavePolicy {
  id          String  @id @default(cuid())
  tenantId    String
  leaveTypeId String
  branchId    String?
  departmentId String?
  annualQuota Decimal @db.Decimal(6, 1)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
}
model LeaveBalance {
  id          String  @id @default(cuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Decimal @db.Decimal(6, 1) @default(0)
  carriedForward Decimal @db.Decimal(6, 1) @default(0)
  used        Decimal @db.Decimal(6, 1) @default(0)
  pending     Decimal @db.Decimal(6, 1) @default(0)
  encashed    Decimal @db.Decimal(6, 1) @default(0)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId, year])
}
model LeaveApplication {
  id          String  @id @default(cuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  isHalfDay   Boolean @default(false)
  isEmergency Boolean @default(false)
  days        Decimal @db.Decimal(6, 1)
  reason      String
  status      LeaveStatus @default(PENDING)
  currentLevel Int    @default(1)
  createdAt   DateTime @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  approvals LeaveApproval[]
  @@index([tenantId, status])
  @@index([employeeId, fromDate])
}
model LeaveApproval {
  id            String @id @default(cuid())
  applicationId String
  level         Int
  approverId    String
  decision      String
  note          String?
  decidedAt     DateTime @default(now())
  application LeaveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum PayrollStatus { DRAFT SUBMITTED APPROVED LOCKED }
enum LoanKind { LOAN ADVANCE }
model CompanySetting {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    Json
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, key])
}
model SalaryStructure {
  id            String   @id @default(cuid())
  tenantId      String
  employeeId    String
  effectiveFrom DateTime @db.Date
  basic         Decimal  @db.Decimal(12, 2)
  hra           Decimal  @db.Decimal(12, 2) @default(0)
  da            Decimal  @db.Decimal(12, 2) @default(0)
  conveyance    Decimal  @db.Decimal(12, 2) @default(0)
  medical       Decimal  @db.Decimal(12, 2) @default(0)
  special       Decimal  @db.Decimal(12, 2) @default(0)
  pfApplicable  Boolean  @default(true)
  esiApplicable Boolean  @default(false)
  ptApplicable  Boolean  @default(false)
  overtimeEligible Boolean @default(false)
  tdsMonthly    Decimal  @db.Decimal(12, 2) @default(0)
  note          String?
  createdById   String
  createdAt     DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([tenantId, employeeId, effectiveFrom])
}
model EmployeeLoan {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  kind       LoanKind @default(LOAN)
  principal  Decimal  @db.Decimal(12, 2)
  emi        Decimal  @db.Decimal(12, 2)
  repaid     Decimal  @db.Decimal(12, 2) @default(0)
  startMonth String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
}
model PayrollRun {
  id            String        @id @default(cuid())
  tenantId      String
  month         String
  status        PayrollStatus @default(DRAFT)
  totalGross    Decimal       @db.Decimal(14, 2) @default(0)
  totalDeductions Decimal     @db.Decimal(14, 2) @default(0)
  totalNet      Decimal       @db.Decimal(14, 2) @default(0)
  employerCost  Decimal       @db.Decimal(14, 2) @default(0)
  createdById   String
  submittedById String?
  approvedById  String?
  lockedById    String?
  lockedAt      DateTime?
  createdAt     DateTime      @default(now())
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  items    PayrollItem[]
  payslips Payslip[]
  @@unique([tenantId, month])
}
model PayrollItem {
  id         String  @id @default(cuid())
  tenantId   String
  runId      String
  employeeId String
  gross      Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  net        Decimal @db.Decimal(12, 2)
  employerCost Decimal @db.Decimal(12, 2) @default(0)
  earnings   Json
  deductions Json
  days       Json
  inputs     Json
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])
  @@unique([runId, employeeId])
}
model Payslip {
  id         String   @id @default(cuid())
  tenantId   String
  runId      String
  employeeId String
  number     String   @unique
  createdAt  DateTime @default(now())
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])
  @@unique([runId, employeeId])
}
model PayrollAdjustment {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  targetMonth  String
  amount       Decimal  @db.Decimal(12, 2)
  reason       String
  appliedRunId String?
  createdById  String
  createdAt    DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String
  title     String
  body      String   @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
model CelebrationTemplate {
  id       String @id @default(cuid())
  tenantId String
  kind     String
  subject  String
  body     String @db.Text
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, kind])
}
model CelebrationEvent {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  kind       String
  year       Int
  years      Int?
  createdAt  DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  logs     CelebrationLog[]
  @@unique([employeeId, kind, year])
  @@index([tenantId, createdAt])
}
model CelebrationLog {
  id        String   @id @default(cuid())
  eventId   String
  channel   String
  status    String
  detail    String?
  createdAt DateTime @default(now())
  event CelebrationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum LeadStatus { NEW CONTACTED INTERESTED CONVERTED LOST }
enum Priority { LOW MEDIUM HIGH }
enum DealStage { NEW_LEAD CONTACTED INTERESTED PROPOSAL NEGOTIATION WON LOST }
enum ActivityKind { CALL MEETING TASK FOLLOW_UP NOTE }
model CrmLead {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  company   String?
  email     String?
  phone     String?
  source    String     @default("Other")
  status    LeadStatus @default(NEW)
  priority  Priority   @default(MEDIUM)
  ownerId   String
  nextFollowUpAt DateTime?
  notes     String?    @db.Text
  convertedCustomerId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  activities CrmActivity[]
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
}
model CrmCustomer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?  @db.Text
  ownerId   String
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  deals      CrmDeal[]
  activities CrmActivity[]
  @@index([tenantId, ownerId])
}
model CrmDeal {
  id        String    @id @default(cuid())
  tenantId  String
  title     String
  customerId String
  leadId    String?
  value     Decimal   @db.Decimal(14, 2)
  stage     DealStage @default(NEW_LEAD)
  expectedClose DateTime? @db.Date
  ownerId   String
  lostReason String?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   CrmCustomer @relation(fields: [customerId], references: [id])
  activities CrmActivity[]
  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
}
model CrmActivity {
  id          String       @id @default(cuid())
  tenantId    String
  kind        ActivityKind
  subject     String
  notes       String?      @db.Text
  dueAt       DateTime?
  doneAt      DateTime?
  ownerId     String
  createdById String
  leadId      String?
  customerId  String?
  dealId      String?
  createdAt   DateTime     @default(now())
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  lead     CrmLead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer CrmCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     CrmDeal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  @@index([tenantId, ownerId, doneAt])
}
model CrmTarget {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  month    String
  amount   Decimal @db.Decimal(14, 2)
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, userId, month])
}

enum ExpenseStatus { PENDING APPROVED REJECTED PAID }
enum AssetStatus { AVAILABLE ASSIGNED RETIRED }
enum CandStage { APPLIED SCREENING INTERVIEW OFFER HIRED REJECTED }
enum TicketStatus { OPEN IN_PROGRESS RESOLVED CLOSED }
model ExpenseClaim {
  id String @id @default(cuid())
  tenantId String
  employeeId String
  category String
  amount Decimal @db.Decimal(12, 2)
  expenseDate DateTime @db.Date
  description String
  receipt Bytes? @db.MediumBlob
  receiptType String?
  status ExpenseStatus @default(PENDING)
  reviewedById String?
  reviewNote String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
}
model Asset {
  id String @id @default(cuid())
  tenantId String
  tag String
  name String
  category String
  serial String?
  purchaseDate DateTime? @db.Date
  status AssetStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  assignments AssetAssignment[]
  @@unique([tenantId, tag])
}
model AssetAssignment {
  id String @id @default(cuid())
  tenantId String
  assetId String
  employeeId String
  assignedAt DateTime @default(now())
  returnedAt DateTime?
  returnNote String?
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([tenantId, employeeId, returnedAt])
}
model JobOpening {
  id String @id @default(cuid())
  tenantId String
  title String
  departmentId String?
  branchId String?
  openings Int @default(1)
  description String? @db.Text
  status String @default("OPEN")
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  candidates Candidate[]
}
model Candidate {
  id String @id @default(cuid())
  tenantId String
  jobId String
  name String
  email String?
  phone String?
  source String?
  stage CandStage @default(APPLIED)
  notes String? @db.Text
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
  job    JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews Interview[]
  @@index([tenantId, stage])
}
model Interview {
  id String @id @default(cuid())
  candidateId String
  scheduledAt DateTime
  interviewerId String?
  mode String @default("In person")
  status String @default("SCHEDULED")
  rating Int?
  feedback String? @db.Text
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}
model PerfCycle {
  id String @id @default(cuid())
  tenantId String
  name String
  fromDate DateTime @db.Date
  toDate DateTime @db.Date
  status String @default("OPEN")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  goals Goal[]
  reviews Review[]
}
model Goal {
  id String @id @default(cuid())
  tenantId String
  employeeId String
  cycleId String
  title String
  kpi String?
  target String?
  weight Int @default(100)
  progress Int @default(0)
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle    PerfCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}
model Review {
  id String @id @default(cuid())
  tenantId String
  employeeId String
  cycleId String
  selfRating Int?
  selfComments String? @db.Text
  mgrRating Int?
  mgrComments String? @db.Text
  reviewerId String?
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle    PerfCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  @@unique([cycleId, employeeId])
}
model Ticket {
  id String @id @default(cuid())
  tenantId String
  employeeId String
  subject String
  description String @db.Text
  category String @default("General")
  priority String @default("MEDIUM")
  status TicketStatus @default(OPEN)
  assigneeId String?
  resolution String? @db.Text
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  comments TicketComment[]
  @@index([tenantId, status])
}
model TicketComment {
  id String @id @default(cuid())
  ticketId String
  authorId String
  authorName String
  body String @db.Text
  createdAt DateTime @default(now())
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}
model Announcement {
  id String @id @default(cuid())
  tenantId String
  title String
  body String @db.Text
  pinned Boolean @default(false)
  expiresAt DateTime?
  createdById String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id])
}
