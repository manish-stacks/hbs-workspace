# ---- copy to /opt/hbs/.env on the server (chmod 600). NEVER commit real values. ----
NODE_ENV=production
TAG=latest
REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
DOMAIN=app.example.com
WEB_URL=https://app.example.com
# RDS MySQL 8 (use a dedicated app user, TLS on)
DATABASE_URL=mysql://hbs_app:CHANGE@your-rds-endpoint.rds.amazonaws.com:3306/hbs_workspace
# openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# openssl rand -hex 32  — encrypts face templates; losing it makes enrolled faces unusable
FACE_ENC_KEY=
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HBS Workspace <no-reply@example.com>"
ENABLE_SWAGGER=false
